  commercialVersion Int                @default(1) @map("commercial_version")
  quoteHash         String             @map("quote_hash") @db.Char(64)
  quoteSnapshotJson Json               @map("quote_snapshot_json")
  activeAttemptId   Int?               @unique @map("active_attempt_id")
  idempotencyKey    String             @map("idempotency_key") @db.VarChar(120)
  version           Int                @default(1)
  paidAt            DateTime?          @map("paid_at") @db.DateTime(3)
  failedAt          DateTime?          @map("failed_at") @db.DateTime(3)
  cancelledAt       DateTime?          @map("cancelled_at") @db.DateTime(3)
