// ─── Phase 1: Booking Core ───────────────────────────────────────────────────

model Booking {
  id                  Int           @id @default(autoincrement())
  bookingNo           String        @unique @map("booking_no") @db.VarChar(30)
  customerId          Int?          @map("customer_id")
  customerAddressId   Int?          @map("customer_address_id")
  cityId              Int           @map("city_id")
  bookedById          Int?          @map("booked_by_id")
  assignedHeroId      Int?          @map("assigned_hero_id")
  partnerHeroId       Int?          @map("partner_hero_id")
  serviceCategoryId   Int?          @map("service_category_id")
  timeSlotId          Int?          @map("time_slot_id")
  bookingType         BookingType   @default(SINGLE) @map("booking_type")
  status              BookingStatus @default(PENDING_ASSIGNMENT)
  idempotencyKey      String?       @map("idempotency_key") @db.VarChar(100)
  idempotencyScope    String?       @map("idempotency_scope") @db.VarChar(100)
  requestFingerprint  String?       @map("request_fingerprint") @db.Char(64)
  creationSource      String        @default("LEGACY") @map("creation_source") @db.VarChar(30)
  // Additive — only ever set for status=LEGACY_ARCHIVED rows. Preserves the
  // real legacy status string (RUNNING/HOLD/etc.) since LEGACY_ARCHIVED alone
  // doesn't distinguish which of the 5 non-terminal legacy states a given
  // row was actually in.
  legacyOriginalStatus String?      @map("legacy_original_status") @db.VarChar(30)
  // Additive, historical-only (Task L). The legacy `orders.delivery_agent`
  // "default hero for this order" field — distinct from `tasks.driver_id`,
  // which LegacyBookingVisit already covers. Populated only for imported
  // bookings that have this legacy data and currently show no
  // LegacyBookingVisit match. NEVER read by dispatch/assignment logic — see
  // Booking.assignedHeroId/partnerHeroId for the only live assignment
  // fields. legacyAssignedHeroName is the raw legacy name string, kept even
  // when legacyAssignedHeroId can't be resolved to an imported Hero.
  legacyAssignedHeroName String?     @map("legacy_assigned_hero_name") @db.VarChar(150)
  legacyAssignedHeroId   Int?        @map("legacy_assigned_hero_id")
  // Additive (Task N.2, Prompt 9). The legacy `orders.pickup_time` slot
  // label ("01-03 PM" etc.) — kept as a raw historical string rather than
  // force-linked to the live TimeSlot table, since the legacy system's 6
  // slots don't map cleanly onto V2's 4 broader windows (ambiguous overlap
  // at the boundaries). Booking.scheduledDate itself IS backfilled directly
  // from the legacy pickup_date/delivery_date, since a plain date has no
  // such ambiguity.
  legacyTimeSlotLabel String?        @map("legacy_time_slot_label") @db.VarChar(30)
  version             Int           @default(1)
  requiredWorkerCount Int           @default(1) @map("required_worker_count")
  workerPlanVersion   Int           @default(1) @map("worker_plan_version")

  // Customer info (denormalized — works for walk-in bookings too)
  customerName     String   @map("customer_name") @db.VarChar(100)
  customerPhone    String   @map("customer_phone") @db.VarChar(15)
  customerAltPhone String?  @map("customer_alt_phone") @db.VarChar(15)
  customerEmail    String?  @map("customer_email") @db.VarChar(100)
  serviceAddress   String   @map("service_address") @db.Text
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)

  scheduledDate          DateTime? @map("scheduled_date") @db.Date
  scheduledFromTime      String?   @map("scheduled_from_time") @db.VarChar(5)
  scheduledToTime        String?   @map("scheduled_to_time") @db.VarChar(5)
  slotStartAt            DateTime? @map("slot_start_at") @db.DateTime(3)
  slotEndAt              DateTime? @map("slot_end_at") @db.DateTime(3)
  serviceDurationMinutes Int?      @map("service_duration_minutes")

  // Pricing
  subtotal      Decimal @default(0.00) @db.Decimal(10, 2)
  discountTotal Decimal @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  taxTotal      Decimal @default(0.00) @map("tax_total") @db.Decimal(10, 2)
  payableTotal  Decimal @default(0.00) @map("payable_total") @db.Decimal(10, 2)
  advancePaid   Decimal @default(0.00) @map("advance_paid") @db.Decimal(10, 2)
  finalPaid     Decimal @default(0.00) @map("final_paid") @db.Decimal(10, 2)

  // Jiffit Coins redeemed against this booking (if any) — payableTotal above
  // already reflects the discount; these two fields just record what was used.
  coinsRedeemed Int     @default(0) @map("coins_redeemed")
  coinsDiscount Decimal @default(0.00) @map("coins_discount") @db.Decimal(10, 2)

  // Charged when the requested slot runs past the hub's shift end (customer
  // booked close enough to shift end that the job spills into overtime).
  // Quoted from IncentivePlan(OVERTIME).overtimeRatePerHour at booking time;
  // payableTotal above already includes this. overtimeMinutes is the quoted
  // spillover (per hero) used to derive the amount, kept for audit/invoicing.
  overtimeFeeAmount Decimal @default(0.00) @map("overtime_fee_amount") @db.Decimal(10, 2)
  overtimeMinutes   Int     @default(0) @map("overtime_minutes")

  couponCode    String?       @map("coupon_code") @db.VarChar(50)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod String?       @map("payment_method") @db.VarChar(50)

  // Cash collection tracking — when a hero collects CASH it is owed to the
  // company until handed over. Online (UPI) payments need no settlement.
  cashSettled     Boolean   @default(false) @map("cash_settled")
  cashSettledAt   DateTime? @map("cash_settled_at")
  cashSettledById Int?      @map("cash_settled_by_id")

  customerNotes      String?   @map("customer_notes") @db.Text
  adminNotes         String?   @map("admin_notes") @db.Text
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  beforePhotoUrl     String?   @map("before_photo_url") @db.VarChar(500)
  afterPhotoUrl      String?   @map("after_photo_url") @db.VarChar(500)
  startOtp           String?   @map("start_otp") @db.VarChar(10)
  startOtpVerifiedAt DateTime? @map("start_otp_verified_at")
  paymentRequestedAt DateTime? @map("payment_requested_at")

  // Auto-dispatch retry counter — incremented each time autoDispatch() finds
  // no eligible hero. The retry cron stops trying once this hits the cap
  // (and sets it to 99 to mark "escalated to Operations").
  autoDispatchAttempts Int @default(0) @map("auto_dispatch_attempts")

  // Package purchases are payment/order records, not operational bookings.
  // Package visit bookings point back to the entitlement they consume.
  isPackagePurchase        Boolean @default(false) @map("is_package_purchase")
  customerServicePackageId Int?    @map("customer_service_package_id")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customer               Customer?                 @relation(fields: [customerId], references: [id])
  customerAddress        CustomerAddress?          @relation(fields: [customerAddressId], references: [id])
  city                   City                      @relation(fields: [cityId], references: [id])
  bookedBy               DashboardUser?            @relation("BookingCreator", fields: [bookedById], references: [id])
  assignedHero           Hero?                     @relation("AssignedHero", fields: [assignedHeroId], references: [id])
  partnerHero            Hero?                     @relation("BookingPartner", fields: [partnerHeroId], references: [id])
  // Historical only — never read by live dispatch/assignment logic. See
  // Booking.legacyAssignedHeroId's own comment above.
  legacyAssignedHero     Hero?                     @relation("LegacyAssignedHero", fields: [legacyAssignedHeroId], references: [id])
  serviceCategory        ServiceCategory?          @relation(fields: [serviceCategoryId], references: [id])
  timeSlot               TimeSlot?                 @relation(fields: [timeSlotId], references: [id])
  items                  BookingItem[]
  statusHistory          BookingStatusHistory[]
  assignments            BookingAssignment[]
  teamMembers            BookingTeamMember[]
  teamRequests           BookingTeamRequest[]
  invoices               Invoice[]
  payments               Payment[]
  paymentOrders           PaymentOrder[]
  review                 BookingReview?
  purchasedPackages      CustomerServicePackage[]  @relation("PackagePurchaseBooking")
  customerServicePackage CustomerServicePackage?   @relation("PackageVisitBookings", fields: [customerServicePackageId], references: [id])
  routeReservations      BookingRouteReservation[]
  dispatch               BookingDispatch?
  dispatchOfferAttempts  BookingOfferAttempt[]
  latestHeroLocations    HeroLatestLocation[]
  legacyVisits           LegacyBookingVisit[]
  legacyInvoiceSnapshots LegacyInvoiceSnapshot[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([cityId])
  @@index([status])
  @@index([customerId])
  @@index([assignedHeroId])
  @@index([partnerHeroId])
  @@index([scheduledDate])
  @@index([slotStartAt])
  @@index([slotEndAt])
  @@index([createdAt])
  @@index([isPackagePurchase])
  @@index([customerServicePackageId])
  @@index([deletedAt])
  @@map("bookings")
}

// ─── Legacy Booking Visits (historical, read-only, additive) ──────────────────
// One row per legacy `tasks` visit record, linked to its already-imported
// parent `Booking`. Purely historical: never read by live dispatch, capacity
// planning, or reporting logic. `legacyDriverId` is always preserved raw;
// `matchedHeroId` is only ever set where a legacy driver_id cleanly resolves
// to an already-imported Hero — never a blind FK copy. Does not touch
// Booking.assignedHeroId/partnerHeroId, BookingAssignment, or any Hero
// duty/location/rating field.
enum LegacyTaskStatus {
  COMPLETED
  CANCELLED
  FAILED
  CONFIRMED
  IN_PROGRESS
  UNKNOWN // raw legacy string didn't match any known value — never guessed
}

model LegacyBookingVisit {
  id                Int              @id @default(autoincrement())
  bookingId         Int              @map("booking_id")
  sourceTaskId      Int              @unique @map("source_task_id")
  visitDate         DateTime         @map("visit_date") @db.Date
  status            LegacyTaskStatus
  rawStatus         String           @map("raw_status") @db.VarChar(30)
  transType         String?          @map("trans_type") @db.VarChar(10)
  suType            String?          @map("su_type") @db.VarChar(10)
  legacyDriverId    Int?             @map("legacy_driver_id")
  matchedHeroId     Int?             @map("matched_hero_id")
  taskDescription   String?          @map("task_description") @db.VarChar(255)
  isHistorical      Boolean          @default(true) @map("is_historical")
  importedAt        DateTime         @default(now()) @map("imported_at")

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  matchedHero Hero?   @relation(fields: [matchedHeroId], references: [id])

  @@index([bookingId])
  @@index([sourceTaskId])
  @@map("legacy_booking_visits")
}

// ─── Legacy Customer Addresses (historical, read-only, additive) ──────────────
// One row per legacy `address` row, verbatim, no validation/trimming. Never
// written into the live CustomerAddress model — CustomerAddress.pincode is
// required non-null and 99.7% of legacy rows don't have a usable one, so this
// is deliberately a separate shadow table, not a filtered/cleaned import.
// customerId is null for rows whose legacy user_id doesn't resolve to an
// imported Customer (e.g. a Hero-role account) — imported anyway, for
// completeness/audit, never skipped.
model LegacyCustomerAddress {
  id              Int       @id @default(autoincrement())
  customerId      Int?      @map("customer_id")
  rawAddressText  String    @map("raw_address_text") @db.Text
  rawAddType      String?   @map("raw_add_type") @db.VarChar(200)
  rawCity         String?   @map("raw_city") @db.VarChar(255)
  rawPincode      String?   @map("raw_pincode") @db.VarChar(200)
  rawLat          String?   @map("raw_lat") @db.VarChar(50)
  rawLng          String?   @map("raw_lng") @db.VarChar(50)
  sourceAddressId Int       @unique @map("source_address_id")
  sourceCreatedAt DateTime? @map("source_created_at")
  importedAt      DateTime  @default(now()) @map("imported_at")

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("legacy_customer_addresses")
}

// ─── Legacy Wallet Transactions (historical, read-only, additive) ─────────────
// Option C (user-confirmed): historical-only. Never spendable — never sums
// into, or otherwise feeds, CustomerWalletTransaction/HeroWalletTransaction
// or any live balance field anywhere in the app. See
// migration-docs/prompt6-plan.md Task F and prompt7-changes.md for the full
// read-only dry-run findings this shape is based on.
enum LegacyWalletTrnType {
  RECEIPT // legacy trn_type=1
  CHARGE // legacy trn_type=2 — subscription "burn" debit
  CREDIT_NOTE // legacy trn_type=3
  DEBIT_NOTE // legacy trn_type=4
}

model LegacyWalletTransaction {
  id       Int  @id @default(autoincrement())
  customerId Int? @map("customer_id")
  // Populated only for CHARGE (trn_type=2) rows, where driver_id is real
  // attribution metadata (confirmed: 100% of driver_id-populated rows are
  // trn_type=2) — resolved via the same phone-based Hero crosswalk every
  // other wave uses, never a blind FK copy.
  attributedHeroId Int? @map("attributed_hero_id")
  sourceTrnId Int @unique @map("source_trn_id")
  trnType  LegacyWalletTrnType @map("trn_type")
  action   String  @db.VarChar(2)
  amount   Decimal @db.Decimal(10, 2)
  occurredAt DateTime @map("occurred_at")
  legacyOrderId Int? @map("legacy_order_id")
  legacyTaskId  Int? @map("legacy_task_id")
  wasSoftDeleted Boolean @default(false) @map("was_soft_deleted")
  description String? @db.Text
  importedAt DateTime @default(now()) @map("imported_at")

  customer       Customer? @relation(fields: [customerId], references: [id])
  attributedHero Hero?     @relation(fields: [attributedHeroId], references: [id])

  @@index([customerId])
  @@map("legacy_wallet_transactions")
}

// ─── Legacy Content Items (historical, read-only, additive) ───────────────────
// Read-only shadow of small legacy content tables. `offers` is deliberately
// excluded — per confirmed decision it's pricing/coupon logic closer to
// Coupon than pure content, a separate later task. Never auto-publishes:
// the real live customer-facing content mechanism is the `customerContent`
// AppSetting JSON namespace, edited only through the existing Settings
// screen — this table is a pure historical reference.
enum LegacyContentType {
  BANNER
  BLOG_POST
  PAGE
  FAQ
  TESTIMONIAL
  CONTACT_MESSAGE
}

model LegacyContentItem {
  id          Int               @id @default(autoincrement())
  contentType LegacyContentType @map("content_type")
  title       String?           @db.VarChar(255)
  body        String?           @db.Text
  // Catch-all for source-specific columns: a banner's photo/link/b_type, a
  // blog's author/category/wp_id, a testimonial's rating/designation, a
  // contact message's sender mobile/email/subject.
  rawFields   Json              @map("raw_fields")
  sourceTable String            @map("source_table") @db.VarChar(30)
  sourceId    Int               @map("source_id")
  importedAt  DateTime          @default(now()) @map("imported_at")

  @@unique([sourceTable, sourceId])
  @@index([contentType])
  @@map("legacy_content_items")
}

// ─── Legacy Invoice Snapshot (historical, read-only, additive) ────────────────
// Prompt 9, Task N.4. A real `invoices` table exists in the legacy dump
// (distinct from — and more complete than — the raw `orders` financial
// columns), covering 9,070 of 15,961 imported bookings. Deliberately NOT
// written into the live `Invoice`/`Payment` tables — a legacy financial
// record indistinguishable from a live one would be a real correctness
// problem for anything that reads those tables expecting current,
// actionable invoices. One booking can have more than one legacy invoice
// (344 legacy orders had multiple, e.g. subscription billing cycles), so
// this is a one-to-many relation, not a 1:1 snapshot.
model LegacyInvoiceSnapshot {
  id                  Int       @id @default(autoincrement())
  bookingId           Int       @map("booking_id")
  sourceInvoiceId     Int       @unique @map("source_invoice_id")
  legacyInvoiceNumber String?   @map("legacy_invoice_number") @db.VarChar(50)
  subTotal            Decimal   @map("sub_total") @db.Decimal(11, 2)
  discountTotal        Decimal  @map("discount_total") @db.Decimal(10, 2)
  discountedTotal      Decimal  @map("discounted_total") @db.Decimal(10, 2)
  gstAmount            Decimal  @map("gst_amount") @db.Decimal(11, 2)
  payableTotal         Decimal  @map("payable_total") @db.Decimal(10, 2)
  totalPaid            Decimal  @map("total_paid") @db.Decimal(10, 2)
  paymentMode          String?  @map("payment_mode") @db.VarChar(30)
  payRef               String?  @map("pay_ref") @db.VarChar(255)
  invoiceDate          DateTime? @map("invoice_date") @db.Date
  billingName          String?  @map("billing_name") @db.VarChar(255)
  billingAddress       String?  @map("billing_address") @db.Text
  // Real per-line-item breakdown from the legacy invoice — deliberately not
  // used to retroactively split the already-imported, single flattened
  // BookingItem row (that row is already live-referenced by invoice PDF
  // generation etc.; splitting it after the fact carries real risk for no
  // proportionate benefit). Surfaced read-only in the dashboard instead.
  rawItems             Json?    @map("raw_items")
  rawActivityLog       Json?    @map("raw_activity_log")
  importedAt           DateTime @default(now()) @map("imported_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("legacy_invoice_snapshots")
}

model BookingDispatch {
