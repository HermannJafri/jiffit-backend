model HeroLeave {
  id              Int             @id @default(autoincrement())
  heroId          Int             @map("hero_id")
  type            HeroLeaveType
  fromDate        DateTime        @map("from_date") @db.Date
  toDate          DateTime        @map("to_date") @db.Date
  isHalfDay       Boolean         @default(false) @map("is_half_day")
  totalDays       Decimal         @map("total_days") @db.Decimal(4, 1)
  reason          String          @db.Text
  proofUrl        String?         @map("proof_url") @db.VarChar(500)
  status          HeroLeaveStatus @default(PENDING)
  reviewedById    Int?            @map("reviewed_by_id")
  reviewedAt      DateTime?       @map("reviewed_at")
  reviewNote      String?         @map("review_note") @db.Text
  // Weekend leave requests — submitted by the hero themselves via
  // POST /hero-leaves/weekend-request (bypasses the normal Sat/Sun block),
  // pending admin review with an attached penalty amount on approval.
  requestedByHero Boolean         @default(false) @map("requested_by_hero")
  penaltyAmount   Decimal?        @map("penalty_amount") @db.Decimal(10, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  hero       Hero           @relation(fields: [heroId], references: [id])
  reviewedBy DashboardUser? @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([heroId, status])
  @@index([fromDate])
  @@map("hero_leaves")
}

