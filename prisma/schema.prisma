  @@map("daily_hero_capacities")
}

// ─── Custom Capacity Groups (dashboard-user-defined, per hub) ─────────────────

model BookingCapacityGroup {
  id          Int      @id @default(autoincrement())
  hubId       Int      @map("hub_id")
  name        String   @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hub         Hub                            @relation(fields: [hubId], references: [id])
  createdBy   DashboardUser                  @relation("CapacityGroupCreatedBy", fields: [createdById], references: [id])
  services    BookingCapacityGroupService[]
  schedules   BookingCapacityGroupSchedule[]
  dailyCounts BookingCapacityDaily[]

  @@index([hubId])
  @@map("booking_capacity_groups")
}

model BookingCapacityGroupService {
  id        Int @id @default(autoincrement())
  groupId   Int @map("group_id")
  serviceId Int @map("service_id")

  group   BookingCapacityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  service Service              @relation(fields: [serviceId], references: [id])

  @@unique([groupId, serviceId])
  @@map("booking_capacity_group_services")
}

model BookingCapacityGroupSchedule {
  id             Int      @id @default(autoincrement())
  groupId        Int      @map("group_id")
  workScheduleId Int      @map("work_schedule_id")
  createdAt      DateTime @default(now()) @map("created_at")

  group        BookingCapacityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule         @relation(fields: [workScheduleId], references: [id])

  @@unique([groupId, workScheduleId])
  @@index([groupId])
  @@map("booking_capacity_group_schedules")
}

model BookingCapacityDaily {
  id             Int      @id @default(autoincrement())
  groupId        Int      @map("group_id")
  capacityDate   DateTime @map("capacity_date") @db.Date
  workScheduleId Int      @map("work_schedule_id")
  heroCount      Int      @default(0) @map("hero_count")
  notes          String?  @db.Text
  setById        Int      @map("set_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  group        BookingCapacityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule         @relation(fields: [workScheduleId], references: [id])
  setBy        DashboardUser        @relation("CapacityDailySetBy", fields: [setById], references: [id])

  @@unique([groupId, capacityDate, workScheduleId])
  @@index([groupId, capacityDate])
  @@map("booking_capacity_daily")
}
