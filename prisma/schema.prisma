  providerPaymentLinkId String?               @map("provider_payment_link_id") @db.VarChar(155)
  providerPaymentId     String?               @map("provider_payment_id") @db.VarChar(155)
  providerReferenceId   String?               @map("provider_reference_id") @db.VarChar(155)
  checkoutUrl           String?               @map("checkout_url") @db.Text
  expiresAt             DateTime?             @map("expires_at") @db.DateTime(3)
  failureCode           String?               @map("failure_code") @db.VarChar(100)
  failureMessageSafe    String?               @map("failure_message_safe") @db.VarChar(500)
  paidAt                DateTime?             @map("paid_at") @db.DateTime(3)
  failedAt              DateTime?             @map("failed_at") @db.DateTime(3)
  expiredAt             DateTime?             @map("expired_at") @db.DateTime(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

