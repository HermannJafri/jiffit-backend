// ─── Jiffit Coins (separate ledger from the rupee wallet above) ───────────────

enum CustomerCoinTxType {
  BOOKING_REWARD
  REFERRAL_BONUS
  SIGNUP_BONUS
  REDEMPTION // negative amount — coins used at checkout
  EXPIRY // negative amount — coins expired
  MANUAL_CREDIT // admin adjustment
  MANUAL_DEBIT // admin adjustment
}

model CustomerCoinTransaction {
  id          Int                @id @default(autoincrement())
  customerId  Int                @map("customer_id")
  type        CustomerCoinTxType
  amount      Int // positive = credit, negative = debit
  description String             @db.VarChar(255)
  referenceId String?            @map("reference_id")
  expiresAt   DateTime?          @map("expires_at")
  // Cron-only bookkeeping: has this row already been folded into an EXPIRY
  // audit entry? Deliberately NOT used by the balance calculation (which
  // relies solely on expiresAt, so balance is correct in real time even if
  // the cron hasn't run yet) — this exists only so the nightly cron doesn't
  // recreate the same "Coins expired" audit row every night forever. See
  // coins.service.ts expireOldCoins() for the full reasoning.
  expired     Boolean            @default(false)
  createdAt   DateTime           @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@map("customer_coin_transactions")
}

