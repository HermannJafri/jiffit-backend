  participantSlotId Int                     @map("participant_slot_id")
  heroId            Int                     @map("hero_id")
  role              DispatchParticipantRole
  attemptNumber     Int                     @map("attempt_number")
  status            OfferAttemptState       @default(PENDING)
  activeKey         String?                 @unique @map("active_key") @db.VarChar(100)
  offerReleaseAt    DateTime                @map("offer_release_at") @db.DateTime(3)
  offerExpiresAt    DateTime                @map("offer_expires_at") @db.DateTime(3)
  deliveredAt       DateTime?               @map("delivered_at") @db.DateTime(3)
