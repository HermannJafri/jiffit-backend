  @@index([status, updatedAt], map: "payment_orders_status_updated_idx")
  @@index([customerId, createdAt], map: "payment_orders_customer_created_idx")
  @@index([bookingId], map: "payment_orders_booking_idx")
  @@map("payment_orders")
}

model PaymentAttempt {
  id                    Int                  @id @default(autoincrement())
  orderId               Int                  @map("order_id")
