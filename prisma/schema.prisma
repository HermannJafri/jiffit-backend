generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DashboardRole {
  SUPER_ADMIN
  ADMIN
  HR
  OPERATIONS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum HeroStatus {
  INCOMPLETE
  PENDING_APPROVAL
  VERIFIED
  SUSPENDED
  REJECTED
}

enum HeroDutyStatus {
  OFFLINE
  ONLINE
  BUSY
}

enum HeroLocationMode {
  DUTY
  ACTIVE_BOOKING
}

enum HeroLocationSource {
  REST
  SOCKET
  FOREGROUND_SERVICE
  ACTIVE_ROUTE
}

enum HeroLocationOrigin {
  GPS
  NETWORK
  FUSED
  UNKNOWN
}

enum DocumentType {
  AADHAR
  PAN
  DRIVING_LICENSE
  SELFIE
  OTHER
}

enum HeroLanguage {
  ENGLISH
  HINDI
  HINGLISH
}

enum WorkType {
  HELPER
  BIKE_RIDER
}

enum VehicleType {
  CYCLE
  BIKE
  ELECTRIC_BIKE
  NO_VEHICLE
  COMPANY_EV
}

enum EarningsType {
  SALARY
  COMMISSION
}

enum OnboardingSource {
  MOBILE_APP
  DASHBOARD
  REFERRAL
  WALK_IN
}

enum HeroLeaveType {
  SICK
  CASUAL
  EMERGENCY
  OTHER
}

enum HeroLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingTeamRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum BookingTeamMemberStatus {
  ACTIVE
  COMPLETED
  REMOVED
}

// ── Phase 1 enums ─────────────────────────────────────────────────────────────

enum BookingType {
  SINGLE
  SUBSCRIPTION
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
  ON_HOLD
  // Historical only — legacy orders imported in a non-terminal legacy status
  // (NEW_BOOKING/PENDING_QUOTE/WORK_DONE/RUNNING/HOLD; see Booking.legacyOriginalStatus
  // for which one). Treated as terminal by assertBookingTransition, identical
  // to CANCELLED/REFUNDED, so no actor can ever transition into or out of it.
  LEGACY_ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  STARTED
  COMPLETED
  CANCELLED
  REASSIGNED
}

enum DispatchState {
  PLANNED
  PREFLIGHT_READY
  OFFER_PENDING
  RETRY_WAIT
  HERO_ACCEPTED
  TEAM_INCOMPLETE
  TEAM_READY
  ESCALATED
  FAILED
  CANCELLED
}

enum DispatchParticipantRole {
  PRIMARY
  HELPER
  RIDER
  SPECIALIST
}

enum DispatchParticipantState {
  PLANNED
  OFFER_PENDING
  ACCEPTED
  RETRY_WAIT
  ESCALATED
  CANCELLED
}

enum OfferAttemptState {
  PENDING
  DELIVERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  FAILED
}

enum DispatchOutboxState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  WALLET
  RAZORPAY
  OTHER
}

enum PaymentEnvironment {
  SANDBOX
  LIVE
}

enum PaymentProvider {
  ZOHO
}

enum PaymentSubjectType {
  BOOKING
  PACKAGE_PURCHASE
}

enum PaymentOrderStatus {
  CREATED
  ATTEMPT_CREATING
  AWAITING_CUSTOMER
  PROCESSING
  PAID
  CREATION_FAILED
  FAILED
  EXPIRED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATING
  AWAITING_CUSTOMER
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELED
  SUPERSEDED
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  QUARANTINED
  FAILED
}

enum PaymentAuditActorType {
  SYSTEM
  CUSTOMER
  HERO
  DASHBOARD
  WEBHOOK
  RECONCILER
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum InvoiceStatus {
  CREATED
  SENT
  PAID
  VOID
  OVERDUE
}

enum CapacityPlanStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum CapacityShiftType {
  MORNING
  GENERAL
}

enum RouteLineStatus {
  OPEN
  ASSIGNED
  AT_RISK
  CLOSED
  CANCELLED
}

enum RouteReservationRole {
  PRIMARY
  SUPPORT
}

enum RouteReservationStatus {
  ACTIVE
  RELEASED
  SUPERSEDED
}

// ─── Role Definitions ─────────────────────────────────────────────────────────

model RoleDefinition {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role_definitions")
}

// ─── Geography ────────────────────────────────────────────────────────────────

model State {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(5)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities              City[]
  holidays            Holiday[]
  operationalSettings OperationalSetting[]
  workSchedules       WorkSchedule[]
  incentivePlans      IncentivePlan[]

  @@map("states")
}

model City {
  id                Int      @id @default(autoincrement())
  stateId           Int      @map("state_id")
  name              String   @db.VarChar(100)
  imageUrl          String?  @map("image_url") @db.VarChar(500) // Phase 0 addition — for customer app city picker
  // Per-city override for "stop accepting new bookings after HH:mm" — falls
  // back to the global AppSetting('booking.cutoffTime') when null. Hubs
  // aren't given their own cutoff because a booking has no hub until a hero
  // is assigned after it's already placed — city is the earliest point at
  // which this is actually known.
  bookingCutoffTime String?  @map("booking_cutoff_time") @db.VarChar(5)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  state               State                    @relation(fields: [stateId], references: [id])
  hubs                Hub[]
  heroes              Hero[]
  dashboardUsers      DashboardUser[]
  dashboardUserScopes DashboardUserCityScope[]
  customerAddresses   CustomerAddress[]
  bookings            Booking[]
  invoices            Invoice[]
  coupons             Coupon[]

  @@index([stateId])
  @@map("cities")
}

model Hub {
  id                  Int      @id @default(autoincrement())
  cityId              Int      @map("city_id")
  name                String   @db.VarChar(100)
  address             String   @db.Text
  latitude            String   @db.VarChar(20)
  longitude           String   @db.VarChar(20)
  checkinRadiusMeters Int      @default(500) @map("checkin_radius_meters")
  serviceRadiusMeters Int      @default(10000) @map("service_radius_meters")
  managerId           Int?     @map("manager_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  city                City                       @relation(fields: [cityId], references: [id])
  manager             DashboardUser?             @relation("HubManager", fields: [managerId], references: [id])
  heroes              Hero[]
  attendance          HeroAttendance[]
  staff               DashboardUser[]            @relation("HubStaff")
  dashboardUserScopes DashboardUserHubScope[]
  operationalSettings OperationalSetting[]
  workSchedules       WorkSchedule[]
  incentivePlans      IncentivePlan[]
  serviceAvailability HubServiceAvailability[]
  capacityPlans       ServiceGroupCapacityPlan[]
  dailyCapacities     DailyHeroCapacity[]
  capacityGroups      BookingCapacityGroup[]

  @@index([cityId])
  @@map("hubs")
}

// ─── Dashboard Users ──────────────────────────────────────────────────────────

model DashboardUser {
  id              Int       @id @default(autoincrement())
  username        String    @unique @db.VarChar(50)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(100)
  email           String?   @unique @db.VarChar(100)
  phone           String?   @unique @db.VarChar(15)
  alternatePhone  String?   @map("alternate_phone") @db.VarChar(15)
  employeeCode    String?   @unique @map("employee_code") @db.VarChar(20)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  profilePhotoUrl String?   @map("profile_photo_url") @db.VarChar(500)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(30)
  bankIfsc          String? @map("bank_ifsc") @db.VarChar(15)
  panCardUrl        String? @map("pan_card_url") @db.VarChar(500)
  aadhaarCardUrl    String? @map("aadhaar_card_url") @db.VarChar(500)
  // Role is now a free string referencing RoleDefinition.name (built-in + custom).
  // The DashboardRole enum below stays as a source of built-in role-name constants.
  role            String    @default("OPERATIONS") @db.VarChar(50)
  cityId          Int?      @map("city_id")
  hubId           Int?      @map("hub_id")
  designation     String?   @db.VarChar(100)
  department      String?   @db.VarChar(100)
  monthlySalary   Decimal?  @map("monthly_salary") @db.Decimal(10, 2)
  address         String?   @db.Text
  joiningDate     DateTime? @map("joining_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  createdById     Int?      @map("created_by_id")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  // Additive — forces the login flow to require a password change before any
  // other action. Always true for bulk-imported legacy accounts (which never
  // receive an imported password); also usable for any future admin-initiated
  // reset flow that should require the user to set their own new password.
  mustResetPassword Boolean @default(false) @map("must_reset_password")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  city                   City?                  @relation(fields: [cityId], references: [id])
  hub                    Hub?                   @relation("HubStaff", fields: [hubId], references: [id])
  createdBy              DashboardUser?         @relation("EmployeeCreator", fields: [createdById], references: [id])
  createdUsers           DashboardUser[]        @relation("EmployeeCreator")
  managedHubs            Hub[]                  @relation("HubManager")
  verifiedHeroes         Hero[]                 @relation("HeroVerifier")
  createdHeroes          Hero[]                 @relation("HeroCreator")
  refreshTokens          RefreshToken[]
  bookedBookings         Booking[]              @relation("BookingCreator")
  assignedBookings       BookingAssignment[]    @relation("Assigner")
  recordedPayments       Payment[]
  statusChanges          BookingStatusHistory[]
  reviewedLeaves         HeroLeave[]            @relation("LeaveReviewer")
  reviewedOffDayRequests OffDayWorkRequest[]    @relation("OffDayReviewer")
  socialPosts            SocialPost[]
  trainingVideos         TrainingVideo[]
  certificates           HeroCertificate[]      @relation("CertificateCreator")
  shopProducts           ShopProduct[]
  faqs                   Faq[]
  supportMessages        SupportChatMessage[]
  heroLocationAccessLogs HeroLocationAccessAudit[]

  // HRA relations
  hraAttendance          DashboardUserAttendance[]
  hraLeavesSubmitted     DashboardUserLeave[]       @relation("HraLeaveOwner")
  hraLeavesReviewed      DashboardUserLeave[]       @relation("HraLeaveReviewer")
  hraAnnouncements       Announcement[]             @relation("AnnouncementAuthor")
  loginLogs              DashboardLoginLog[]
  cityScopes             DashboardUserCityScope[]
  hubScopes              DashboardUserHubScope[]
  capacityPlansCreated   ServiceGroupCapacityPlan[] @relation("CapacityPlanCreator")
  capacityPlansUpdated   ServiceGroupCapacityPlan[] @relation("CapacityPlanUpdater")
  capacityPlansPublished ServiceGroupCapacityPlan[] @relation("CapacityPlanPublisher")
  capacityPlansLocked    ServiceGroupCapacityPlan[] @relation("CapacityPlanLocker")
  dailyHeroCapacitiesSet DailyHeroCapacity[]        @relation("DailyCapacitySetBy")
  capacityGroupsCreated  BookingCapacityGroup[]     @relation("CapacityGroupCreatedBy")
  capacityDailySet       BookingCapacityDaily[]     @relation("CapacityDailySetBy")

  @@index([cityId])
  @@index([hubId])
  @@index([role])
  @@map("dashboard_users")
}

model DashboardUserCityScope {
  id              Int @id @default(autoincrement())
  dashboardUserId Int @map("dashboard_user_id")
  cityId          Int @map("city_id")

  dashboardUser DashboardUser @relation(fields: [dashboardUserId], references: [id], onDelete: Cascade)
  city          City          @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([dashboardUserId, cityId])
  @@index([cityId])
  @@map("dashboard_user_city_scopes")
}

model DashboardUserHubScope {
  id              Int @id @default(autoincrement())
  dashboardUserId Int @map("dashboard_user_id")
  hubId           Int @map("hub_id")

  dashboardUser DashboardUser @relation(fields: [dashboardUserId], references: [id], onDelete: Cascade)
  hub           Hub           @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([dashboardUserId, hubId])
  @@index([hubId])
  @@map("dashboard_user_hub_scopes")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Heroes ───────────────────────────────────────────────────────────────────

model Hero {
  id              Int       @id @default(autoincrement())
  phone           String    @unique @db.VarChar(15)
  name            String?   @db.VarChar(100)
  email           String?   @unique @db.VarChar(100)
  gender          Gender?
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  profilePhotoUrl String?   @map("profile_photo_url") @db.VarChar(500)

  addressLine1  String?  @map("address_line1") @db.VarChar(255)
  addressLine2  String?  @map("address_line2") @db.VarChar(255)
  pincode       String?  @db.VarChar(10)
  homeLatitude  Decimal? @map("home_latitude") @db.Decimal(10, 8)
  homeLongitude Decimal? @map("home_longitude") @db.Decimal(11, 8)

  // Personal & document fields (Phase 0)
  aadhaarNumber         String? @map("aadhaar_number") @db.VarChar(20)
  panNumber             String? @map("pan_number") @db.VarChar(20)
  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(15)
  whatsappOptIn         Boolean @default(true) @map("whatsapp_opt_in")

  bankAccountName   String? @map("bank_account_name") @db.VarChar(100)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(30)
  bankIfsc          String? @map("bank_ifsc") @db.VarChar(15)
  // Additive — same copy-pasted HR-style field as legacy admin.gst_no,
  // length matches its varchar(15). See migration-docs/prompt6-plan.md Task H.
  gstNumber         String? @map("gst_no") @db.VarChar(15)
  // Additive — set true for every hero whose bank/KYC data comes from the
  // legacy bulk import rather than the normal V2 onboarding review flow.
  // HR-facing filter only; never read by payout/dispatch logic. Same
  // precedent as Hero.needsSpotCheck above.
  bankDetailsNeedsReview Boolean @default(false) @map("bank_details_needs_review")

  cityId Int? @map("city_id")
  hubId  Int? @map("hub_id")

  status                   HeroStatus     @default(INCOMPLETE)
  dutyStatus               HeroDutyStatus @default(OFFLINE) @map("duty_status")
  connectivityStatus       HeroConnectivityStatus @default(OFFLINE) @map("connectivity_status")
  currentLat               Decimal?       @map("current_lat") @db.Decimal(10, 8)
  currentLng               Decimal?       @map("current_lng") @db.Decimal(11, 8)
  currentLocationUpdatedAt DateTime?      @map("current_location_updated_at") @db.DateTime(3)

  verifiedAt      DateTime? @map("verified_at")
  verifiedById    Int?      @map("verified_by_id")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdById     Int?      @map("created_by_id")

  // Additive — true only for heroes bulk-verified from a confirmed-active
  // legacy account rather than through the normal V2 onboarding/document
  // review flow. Never read by dispatch/eligibility logic (which already only
  // checks status == VERIFIED); exists purely so operations/HR can see,
  // filter, and prioritize this cohort for a real one-time spot-check.
  // Auto-clears when an operator verifies/re-verifies the hero through the
  // existing Verify action.
  needsSpotCheck Boolean @default(false) @map("needs_spot_check")

  fatherName       String?           @map("father_name") @db.VarChar(100)
  alternatePhone   String?           @unique @map("alternate_phone") @db.VarChar(15)
  language         HeroLanguage?
  workType         WorkType?         @map("work_type")
  vehicleType      VehicleType?      @map("vehicle_type")
  earningsType     EarningsType?     @map("earnings_type")
  onboardingSource OnboardingSource? @map("onboarding_source")
  upiId            String?           @map("upi_id") @db.VarChar(100)

  referralCode     String? @unique @map("referral_code") @db.VarChar(20)
  referredByHeroId Int?    @map("referred_by_hero_id")

  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  blacklistReason String?   @map("blacklist_reason") @db.Text
  blacklistedAt   DateTime? @map("blacklisted_at")

  deviceToken        String?      @map("device_token") @db.VarChar(500)
  locationPermission Boolean      @default(false) @map("location_permission")
  devices            HeroDevice[]

  rating        Decimal @default(0.00) @db.Decimal(3, 2)
  totalRatings  Int     @default(0) @map("total_ratings")
  totalBookings Int     @default(0) @map("total_bookings")

  // HR: monthly salary for payroll (used when earningsType = SALARY)
  monthlySalary        Decimal? @map("monthly_salary") @db.Decimal(10, 2)
  // HR: commission rate, e.g. 15.00 = 15% of each completed booking's payableTotal
  // (used when earningsType = COMMISSION; ignored otherwise)
  commissionPercentage Decimal? @map("commission_percentage") @db.Decimal(5, 2)

  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at")
  deleteRequestedAt DateTime? @map("delete_requested_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  city                        City?                        @relation(fields: [cityId], references: [id])
  hub                         Hub?                         @relation(fields: [hubId], references: [id])
  verifiedBy                  DashboardUser?               @relation("HeroVerifier", fields: [verifiedById], references: [id])
  createdBy                   DashboardUser?               @relation("HeroCreator", fields: [createdById], references: [id])
  referredByHero              Hero?                        @relation("HeroReferral", fields: [referredByHeroId], references: [id])
  referredHeroes              Hero[]                       @relation("HeroReferral")
  documents                   HeroDocument[]
  jobRoles                    HeroJobRole[]
  skills                      HeroSkill[]
  attendance                  HeroAttendance[]
  refreshTokens               HeroRefreshToken[]
  assignments                 BookingAssignment[]
  assignedBookings            Booking[]                    @relation("AssignedHero")
  partnerBookings             Booking[]                    @relation("BookingPartner")
  legacyAssignedBookings       Booking[]                    @relation("LegacyAssignedHero")
  statusChanges               BookingStatusHistory[]
  leaves                      HeroLeave[]
  offDayWorkRequests          OffDayWorkRequest[]
  teamOwnerships              HeroTeamMember[]             @relation("TeamOwner")
  teamMemberships             HeroTeamMember[]             @relation("TeamMember")
  invitationsSent             HeroTeamInvitation[]         @relation("InvitationsSent")
  invitationsReceived         HeroTeamInvitation[]         @relation("InvitationsReceived")
  bookingTeamRequestsSent     BookingTeamRequest[]         @relation("BookingTeamRequestsSent")
  bookingTeamRequestsReceived BookingTeamRequest[]         @relation("BookingTeamRequestsReceived")
  bookingTeamMemberships      BookingTeamMember[]
  bookingTeamMembersInvited   BookingTeamMember[]          @relation("BookingTeamMemberInviter")
  socialPosts                 SocialPost[]
  certificates                HeroCertificate[]
  walletTransactions          HeroWalletTransaction[]
  supportThreads              SupportChatThread[]
  bookingReviews              BookingReview[]
  connectivityLogs            HeroConnectivityLog[]
  referralBonusPaidAt         DateTime?                    @map("referral_bonus_paid_at")
  capacityRouteLines          ServiceGroupRouteLine[]
  dispatchOfferAttempts       BookingOfferAttempt[]
  acceptedDispatchSlots       BookingDispatchParticipant[]
  latestLocation              HeroLatestLocation?
  locationAccessLogs          HeroLocationAccessAudit[]
  legacyBookingVisits         LegacyBookingVisit[]
  legacyWalletTransactions    LegacyWalletTransaction[]

  @@index([phone])
  @@index([cityId])
  @@index([hubId])
  @@index([status])
  @@index([isBlacklisted])
  @@index([referralCode])
  @@map("heroes")
}

model HeroDevice {
  id             Int      @id @default(autoincrement())
  installationId String   @unique @map("installation_id") @db.VarChar(100)
  heroId         Int      @map("hero_id")
  fcmToken       String   @unique @map("fcm_token") @db.VarChar(500)
  platform       String?  @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  lastSeenAt     DateTime @updatedAt @map("last_seen_at")

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@index([heroId])
  @@map("hero_devices")
}

model HeroDocument {
  id         Int          @id @default(autoincrement())
  heroId     Int          @map("hero_id")
  type       DocumentType
  number     String?      @db.VarChar(50)
  frontUrl   String?      @map("front_url") @db.VarChar(500)
  backUrl    String?      @map("back_url") @db.VarChar(500)
  isVerified Boolean      @default(false) @map("is_verified")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, type])
  @@index([heroId])
  @@map("hero_documents")
}

// selfieUrl is nullable until file upload is implemented
model HeroAttendance {
  id                Int       @id @default(autoincrement())
  heroId            Int       @map("hero_id")
  hubId             Int       @map("hub_id")
  selfieUrl         String?   @map("selfie_url") @db.VarChar(500)
  checkOutSelfieUrl String?   @map("check_out_selfie_url") @db.VarChar(500)
  latitude          Decimal   @db.Decimal(10, 8)
  longitude         Decimal   @db.Decimal(11, 8)
  distanceMeters    Int       @map("distance_meters")
  checkedInAt       DateTime  @map("checked_in_at")
  checkedOutAt      DateTime? @map("checked_out_at")
  checkoutReason    String?   @map("checkout_reason") @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at")

  hero Hero @relation(fields: [heroId], references: [id])
  hub  Hub  @relation(fields: [hubId], references: [id])
  latestLocations HeroLatestLocation[]

  @@index([heroId])
  @@index([hubId])
  @@index([checkedInAt])
  @@map("hero_attendance")
}

// Pure observability log — does not drive Hero.dutyStatus itself (that's set
// directly by the socket disconnect/join handlers in server.ts). Lets the
// dashboard show a hero's actual online/offline history while on duty,
// instead of just their current instantaneous status.
model HeroConnectivityLog {
  id         Int                    @id @default(autoincrement())
  heroId     Int                    @map("hero_id")
  status     HeroConnectivityStatus
  occurredAt DateTime               @default(now()) @map("occurred_at")

