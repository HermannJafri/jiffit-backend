# App
NODE_ENV=development
PORT=5000

# Database
# Keep connection_limit explicit so Prisma does not size the pool from CPU count.
DATABASE_URL="mysql://root:password@localhost:3306/jiffit_dev?connection_limit=10&pool_timeout=20"

# JWT
JWT_SECRET=change_me_access_secret_min_32_chars____
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars___
JWT_REFRESH_EXPIRES_IN=7d

# OTP / SMS
OTP_TEST_MODE_ENABLED=true
ALLOW_MASTER_OTP_TEMPORARILY=false
MASTER_OTP=
OTP_HASH_SECRET=change_me_otp_hash_secret_min_32_chars___
TEAM_INVITATION_TTL_SECONDS=60
FAST2SMS_API_KEY=
FAST2SMS_ENABLED=false
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_OTP_ROUTE=otp
FAST2SMS_TIMEOUT_MS=8000

# Dispatch
DISPATCH_ACCEPTANCE_WINDOW_SECONDS=90
DISPATCH_REASSIGNMENT_BUFFER_MINUTES=5
DISPATCH_CLEANUP_PREP_BUFFER_MINUTES=10
DISPATCH_FINAL_REMINDER_MINUTES=15
DISPATCH_LOCATION_FRESHNESS_SECONDS=120
DISPATCH_POLL_INTERVAL_SECONDS=30
DISPATCH_LEASE_SECONDS=60
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_MIN_NOTICE_MINUTES=1
DISPATCH_FEATURE_ENABLED=false
DISPATCH_SHADOW_MODE=true
DISPATCH_TEST_BOOKING_PREFIX=

# Hero location
HERO_LOCATION_DUTY_STALE_SECONDS=600
HERO_LOCATION_ACTIVE_STALE_SECONDS=45
HERO_LOCATION_DUTY_MIN_INTERVAL_SECONDS=30
HERO_LOCATION_ACTIVE_MIN_INTERVAL_SECONDS=3
HERO_LOCATION_RETENTION_DAYS=30

# Firebase Admin (push)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# DigitalOcean Spaces — existing production Space; do not delete objects
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_CDN_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Zoho Payments — same account/config as the rewrite when going live
ZOHO_PAYMENTS_ENABLED=false
ZOHO_PAYMENTS_ENVIRONMENT=SANDBOX
ZOHO_PAYMENTS_BASE_URL=https://paymentssandbox.zoho.in/api/v1
ZOHO_PAYMENTS_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_WEBHOOK_SIGNING_KEY=
ZOHO_PAYMENTS_RETURN_SIGNING_KEY=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_RETURN_URL=
ZOHO_PAYMENTS_CURRENCY=INR
ZOHO_PAYMENTS_ALLOWED_METHODS=upi,card
ZOHO_PAYMENTS_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
ZOHO_PAYMENTS_HTTP_TIMEOUT_MS=8000
ZOHO_PAYMENTS_RECONCILIATION_ENABLED=false
ZOHO_PAYMENTS_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_MOCK_ENABLED=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000
